{
  "manifest_version": 3,
  "name": "Save image as PNG",
  "version": "0.1.0",
  "description": "Right-click an image and save it as PNG.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "画像をPNGで保存",
    "default_popup": "popup.html"
  }
}
